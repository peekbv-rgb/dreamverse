__d("AdsInsightsMetricDefinitionsUngatedStatic",["fbt"],(function(t,n,r,o,a,i,l){a.exports={definitions:{adgroup_id:l._(/*BTDS*/"De unieke ID van de advertentie die je bekijkt in rapporten."),last_significant_edit:l._(/*BTDS*/"De recentste datum waarop je een significante wijziging in je campagne of advertentieset hebt aangebracht, waardoor de {=learning phase} mogelijk opnieuw wordt gestart. Een significante wijziging is bijvoorbeeld wanneer je je advertentieset pauzeert of een wijziging aanbrengt in een optimalisatiegebeurtenis, doelgroep of advertentiemateriaal. Wijzigingen in de bodstrategie of het budget kunnen ook significant zijn, maar dit is afhankelijk van de impact van de wijziging.",[l._param("=learning phase","learning phase")]),bid:l._(/*BTDS*/"De manier waarop je wilt dat Meta in de veiling biedt, gebaseerd op je doelstellingen voor kosten en je optimalisatie voor advertentieweergave. Dit wordt weergegeven als laagste kosten, kostenlimiet, bodlimiet, doelkosten, hoogste waarde of minimale ROAS, afhankelijk van je gekozen instellingen voor kosten of ROAS."),budget:l._(/*BTDS*/"Het maximale bedrag dat je wilt uitgeven aan je advertentiesets of campagnes, gemiddeld per dag of gedurende de looptijd van je geplande advertentiesets of campagnes."),buying_type:l._(/*BTDS*/"In Advertentiebeheer heb je 2 opties om te betalen voor advertenties in je campagne: veiling biedt dynamisch bieden en reserveren biedt bieden met een vaste prijs."),deal_end:l._(/*BTDS*/"De einddatum van de aanbieding die aan deze campagne, advertentieset of advertentie is gekoppeld."),deal_start:l._(/*BTDS*/"De startdatum van de aanbieding die aan deze campagne, advertentieset of advertentie is gekoppeld."),schedule:l._(/*BTDS*/"De begin- en einddatum van je advertentiesets."),start_time:l._(/*BTDS*/"De datum waarop je campagne start of de start van je campagne staat gepland. De begindatum van een campagne is gebaseerd op de door jou gekozen planning in de advertentieset van de campagne."),stop_time:l._(/*BTDS*/"De datum waarop je campagne is be\u00ebindigd of waarop het einde van je campagne staat gepland. De einddatum van een campagne is gebaseerd op de door jou gekozen planning in de advertentieset van de campagne."),conversions:l._(/*BTDS*/"Het totale aantal gesprekken dat is toegeschreven aan je advertenties, inclusief contact, customize_product, donate, find_location, schedule, start_trial, submit_application, subscribe."),conversion_values:l._(/*BTDS*/"De totale waarde van alle gesprekken die zijn toegeschreven aan je advertenties, waaronder contact, customize_product, donate, find_location, schedule, start_trial, submit_application, subscribe."),cost_per_conversion:l._(/*BTDS*/"De gemiddelde kosten van een conversie op alle kanalen (bijv. website, in de app, offline en op Facebook). Conversies omvatten contact, product aanpassen, doneren, locatie zoeken, plannen, proef starten, sollicitatie verzenden, abonneren."),canvas_avg_view_percentage_per_component:l._(/*BTDS*/"Het gemiddelde weergavepercentage per canvascomponent"),conversion_location:l._(/*BTDS*/"De conversielocatie is de plaats waar je wilt dat zakelijke resultaten worden behaald, zoals je website, winkel, of website en winkel."),cost_per_unique_action_type:l._(/*BTDS*/"De gemiddelde kosten per unieke actie. Dit is een geschatte statistiek."),action_canvas_component_id:l._(/*BTDS*/"ID van een onderdeel binnen een canvasadvertentie"),action_canvas_component_name:l._(/*BTDS*/"Naam van een onderdeel binnen een canvasadvertentie"),action_carousel_card_id:l._(/*BTDS*/"De id van de specifieke carousselkaart waarmee mensen interactie hadden op het moment dat ze je advertentie zagen."),action_carousel_card_name:l._(/*BTDS*/"De specifieke carrouselkaart waarop mensen hebben gereageerd toen ze je advertentie zagen. De kaarten zijn herkenbaar aan de kopteksten."),action_converted_product_id:l._(/*BTDS*/"De ID van het specifieke productitem in de conversiegebeurtenis."),action_destination:l._(/*BTDS*/"De bestemming waar mensen terechtkomen nadat ze op je advertentie hebben geklikt. De bestemming kan je Facebook-pagina zijn, een externe URL voor je conversiepixel of een app die is geconfigureerd met de SDK (Software Development Kit)."),action_device:l._(/*BTDS*/"Het apparaat waarop de conversiegebeurtenis die je bijhoudt, heeft plaatsgevonden. Bijvoorbeeld Desktop als iemand een conversie heeft uitgevoerd op een computer."),action_link_click_destination:l._(/*BTDS*/"De bestemming buiten Meta waar gebruikers naartoe worden geleid als ze op je advertentie klikken."),action_location_code:l._(/*BTDS*/"De locatiecodes die in de offline acties worden gebruikt."),action_reaction:l._(/*BTDS*/"Het aantal reacties op je advertenties of gepromote berichten. Via de reactiebalk in een advertentie kunnen mensen op de inhoud reageren met verschillende reacties: Leuk, Geweldig, Grappig, Verbluft, Verdrietig of Boos."),action_target_id:l._(/*BTDS*/"De ID van de bestemming waar mensen naartoe worden geleid na op je advertentie te hebben geklikt. Deze bestemming kan je Facebook-pagina, een externe URL voor je conversiepixel of een app geconfigureerd met de SDK (software development kit) zijn."),action_type:l._(/*BTDS*/"De acties die zijn ondernomen voor je advertentie, pagina, app of evenement nadat je advertentie aan iemand is weergegeven, zelfs als deze persoon hier niet op heeft geklikt. Actietypen omvatten pagina-vind-ik-leuks, appinstallaties, conversies, reacties op evenementen en meer."),action_video_sound:l._(/*BTDS*/"De geluidsstatus (aan\/uit) wanneer iemand je videoadvertentie afspeelt."),action_video_type:l._(/*BTDS*/"Specificatie van videostatistieken."),action_video_asset_id:l._(/*BTDS*/"Specificatie van ID-statistieken voor videomiddelen."),account_currency:l._(/*BTDS*/"Munteenheid die wordt gebruikt door je advertentieaccount."),account_default_attribution_windows:l._(/*BTDS*/"De door je advertentieaccount gebruikte standaard toeschrijvingsvensters."),account_id:l._(/*BTDS*/"De ID van je advertentieaccount, waarmee je advertentieactiviteiten worden gebundeld. Je advertentieaccount omvat je campagnes, advertenties en facturen."),account_name:l._(/*BTDS*/"De naam van je advertentieaccount, dat je advertentieactiviteiten bundelt. Je advertentieaccount omvat je campagnes, advertenties en facturen."),actions_per_impression:l._(/*BTDS*/"Totaal aantal acties gedeeld door het aantal weergaven."),actions_results:l._(/*BTDS*/"Het aantal acties als resultaat van je advertentie. De resultaten die je hier ziet, zijn gebaseerd op je doelstelling."),ad_schedule:l._(/*BTDS*/"De begin- en einddatums van je advertenties met afzonderlijke planningen. Deze kolom is alleen van toepassing op app-promotie- en verkoopcampagnes."),activity_recency:l._(/*BTDS*/"Dit toont een overzicht van resultaten ingedeeld op basis van de recente activiteit van de kijker buiten de site."),adgroup_delivery:l._(/*BTDS*/"Hier kun je zien of je advertentie momenteel wordt uitgevoerd."),adgroup_name:l._(/*BTDS*/"De naam van de advertentie die je bekijkt in de rapportage."),ad_format_asset:l._(/*BTDS*/"De ID van het advertentieformaatmiddel dat is betrokken bij de vertoning, klik of actie."),age:l._(/*BTDS*/"De leeftijdscategorie van de personen die je hebt bereikt."),app_store_clicks:l._(/*BTDS*/"Het aantal klikken op links naar een app store in je advertenties."),app_id:l._(/*BTDS*/"De ID van de app die is gekoppeld aan het aangevraagde advertentieaccount of de aangevraagde campagne."),attention_events_per_impression:l._(/*BTDS*/"Het aantal keren dat mensen meer aandacht hebben besteed aan je advertenties dan ze normaal gesproken besteden aan andere berichten en advertenties die ze op Facebook of Instagram zien, gedeeld door het totale aantal weergaven."),attention_events_unq_per_reach:l._(/*BTDS*/"Het aantal mensen dat meer aandacht heeft besteed aan je advertenties dan ze normaal gesproken aan andere berichten besteden die ze op Facebook zien, gedeeld door het aantal mensen dat je met je advertenties hebt bereikt."),auction_bid:l._(/*BTDS*/"Velingbod helpt je begrijpen hoe Meta namens jou bied op basis van je advertentie-instellingen."),auction_max_competitor_bid:l._(/*BTDS*/"Het maximumbod voor concurrentie in de veiling geeft je inzicht in hoe andere advertenties binnen veilingen waaraan deze advertentie heeft deelgenomen in de loop der tijd zijn veranderd."),business_contact_option_clicks:l._(/*BTDS*/"Het aantal klikken op bestelopties in de advertentie dat heeft geleid naar door de adverteerder opgegeven bestemmingen, op of buiten Meta."),business_image_clicks:l._(/*BTDS*/"Het totale aantal klikken op de menufoto's in een advertentie."),wish_bid:l._(/*BTDS*/"De index voor concurrentie in de veiling geeft je inzicht in hoe de concurrentie binnen de veilingen van deze advertentie door de tijd heen is veranderd."),auction_competitiveness:l._(/*BTDS*/"Concurrentie in de veiling geeft je inzicht in je positie in de markt en helpt je detecteren wanneer er meer concurrentie is, waardoor je kans om te winnen kleiner kan worden."),impressions_auto_refresh:l._(/*BTDS*/"Het aantal keer dat je advertenties zijn weergegeven in de rechterkolom van Facebook nadat de advertentieplaatsing werd vernieuwd."),body_asset:l._(/*BTDS*/"De ID van het middel van de weergave, klik of actie"),call_to_action_asset:l._(/*BTDS*/"De ID van het actiemiddel dat betrokken was bij de vertoning, klik of actie."),call_to_action_clicks:l._(/*BTDS*/"Het aantal keer dat mensen op de actieknop op je advertentie hebben geklikt."),campaign_delivery:l._(/*BTDS*/"Hier kun je zien of je advertentieset momenteel wordt uitgevoerd."),campaign_end:l._(/*BTDS*/"De datum waarop het einde van je advertentieset staat gepland."),campaign_group_delivery:l._(/*BTDS*/"Hier kun je zien of je campagne momenteel wordt uitgevoerd."),campaign_group_id:l._(/*BTDS*/"De unieke ID van de advertentiecampagne die je bekijkt in rapporten. Je campagne bevat advertentiesets en advertenties."),campaign_group_name:l._(/*BTDS*/"De naam van de advertentiecampagne die je bekijkt in rapporten. Je campagne bevat advertentiesets en advertenties."),campaign_id:l._(/*BTDS*/"De unieke ID van de advertentieset die je bekijkt in rapporten. Een advertentieset is een groep advertenties die hetzelfde budget en dezelfde planning, weergaveoptimalisatie en doelgroep delen."),campaign_name:l._(/*BTDS*/"De naam van de advertentieset die je bekijkt in rapporten. Een advertentieset is een groep advertenties die hetzelfde budget en dezelfde planning, weergaveoptimalisatie en doelgroep delen."),campaign_start:l._(/*BTDS*/"De datum waarop je de start van je advertentieset staat gepland."),canvas_avg_view_percent:l._(/*BTDS*/"Het gemiddelde percentage van de Instant Experience dat is bekeken. Een Instant Experience is een scherm dat wordt geopend nadat iemand interactie heeft met je advertentie op een mobiel apparaat. De Instant Experience kan een reeks interactieve of multimedia-onderdelen bevatten, waaronder video's, afbeeldingen, producten en meer."),canvas_avg_view_time:l._(/*BTDS*/"De gemiddelde totale tijd (in seconden) die mensen besteden in een Instant Experience. Een Instant Experience is een scherm dat wordt geopend nadat iemand interactie heeft met je advertentie op een mobiel apparaat. De Instant Experience kan een reeks interactieve of multimedia-onderdelen bevatten, waaronder video's, afbeeldingen, producten en meer."),instant_experience_element_impressions:l._(/*BTDS*/"Het aantal keer dat Instant Experience-onderdelen zijn weergegeven op het scherm."),instant_experience_element_reach:l._(/*BTDS*/"Het aantal mensen dat je Instant Experience ten minste \u00e9\u00e9n keer heeft gezien. Instant Experience-bereik is anders dan weergaven. Instant Experience-weergaven kan meerdere weergaven door dezelfde mensen bevatten."),card_views:l._(/*BTDS*/"Het aantal keer dat mensen een product uit je catalogus hebben bekeken in een advertentie. Als je een carrouselindeling gebruikt, kunnen mensen meerdere producten in \u00e9\u00e9n advertentie zien. De cijfers worden dagelijkse bijgewerkt, weergaven voor vandaag zijn niet meegeteld. Deze statistiek bevindt zich momenteel in de b\u00e8tafase en is alleen beschikbaar voor advertenties die aan een productcatalogus zijn gekoppeld."),card_view_frequency:l._(/*BTDS*/"Het gemiddelde aantal keer dat elke persoon individuele kaarten heeft bekeken in een carrousel in je advertenties."),card_view_ctr:l._(/*BTDS*/"Het percentage keren dat mensen individuele kaarten in een carrousel bekeken in je advertenties en een {=link click} uitvoerden.",[l._param("=link click","link click")]),unique_card_view_ctr:l._(/*BTDS*/"Het percentage mensen dat individuele kaarten in een carrousel zag in je advertenties en een {=link click} uitvoerden.",[l._param("=link click","link click")]),clicks:l._(/*BTDS*/"Het aantal klikken, tikken of vegen op je advertenties."),catalog_segment_value:l._(/*BTDS*/"De totale waarde van alle conversies van je catalogussegment, toegeschreven aan je advertenties."),catalog_segment_actions:l._(/*BTDS*/"Het totale aantal conversies van je catalogussegment, toegeschreven aan je advertenties."),"catalog_segment_actions:omni_purchase":l._(/*BTDS*/"Het aantal aankoopgebeurtenissen dat ten minste \u00e9\u00e9n gedeeld item bevat, gebaseerd op gegevens van een of meer gekoppelde Meta Business-hulpmiddelen van je partner."),"catalog_segment_actions:offline_conversion.purchase":l._(/*BTDS*/"Het aantal aankoopgebeurtenissen dat ten minste \u00e9\u00e9n gedeeld item bevat, dat is geregistreerd door de offline-gebeurtenisgegevens van je partner en toegeschreven aan je advertenties."),"action_values:app_custom_event.fb_mobile_achievement_unlocked":l._(/*BTDS*/"De totale waarde uit {=mobile app achievements unlocked}. Deze statistiek is gebaseerd op de waarde die je hebt toegewezen toen je de appgebeurtenis instelde.",[l._param("=mobile app achievements unlocked","mobile app achievements unlocked")]),"action_values:app_custom_event.fb_mobile_add_payment_info":l._(/*BTDS*/"De totale waarde uit {=mobile app adds of payment info}. Deze statistiek is gebaseerd op de waarde die je hebt toegewezen toen je de appgebeurtenis instelde.",[l._param("=mobile app adds of payment info","mobile app adds of payment info")]),"action_values:app_custom_event.fb_mobile_level_achieved":l._(/*BTDS*/"De totale waarde uit {=mobile app levels completed}. Deze statistiek is gebaseerd op de waarde die je hebt toegewezen toen je de appgebeurtenis instelde.",[l._param("=mobile app levels completed","mobile app levels completed")]),"action_values:app_custom_event.fb_mobile_complete_registration":l._(/*BTDS*/"De totale waarde uit {=mobile app registrations completed}. Deze statistiek is gebaseerd op de waarde die je hebt toegewezen toen je de appgebeurtenis instelde.",[l._param("=mobile app registrations completed","mobile app registrations completed")]),"action_values:app_custom_event.fb_mobile_activate_app":l._(/*BTDS*/"De totale waarde uit {=mobile app sessions}. Deze statistiek is gebaseerd op de waarde die je hebt toegewezen toen je de appgebeurtenis instelde.",[l._param("=mobile app sessions","mobile app sessions")]),"action_values:app_custom_event.fb_mobile_tutorial_completion":l._(/*BTDS*/"De totale waarde uit {=mobile app tutorials completed}. Deze statistiek is gebaseerd op de waarde die je hebt toegewezen toen je de appgebeurtenis instelde.",[l._param("=mobile app tutorials completed","mobile app tutorials completed")]),"catalog_segment_actions:app_custom_event.fb_mobile_purchase":l._(/*BTDS*/"Het aantal aankopen in de app met ten minste \u00e9\u00e9n gedeeld item."),"catalog_segment_actions:offsite_conversion.fb_pixel_purchase":l._(/*BTDS*/"Het aantal aankoopgebeurtenissen dat ten minste \u00e9\u00e9n gedeeld item bevat, dat is bijgehouden door de pixel op de website van je partner en dat is toegeschreven aan je advertenties."),"catalog_segment_actions:omni_add_to_cart":l._(/*BTD