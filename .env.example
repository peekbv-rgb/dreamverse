# Kopieer naar .env en vul in. .env staat in .gitignore; dit bestand niet,
# dus zet hier nooit een echte sleutel neer.

# Zonder sleutel draait de app in voorbeeldmodus: elke droom geeft dezelfde
# voorbeeldaflevering terug. Handig om te demonstreren, kost niets.
ANTHROPIC_API_KEY=

# Lokaal 127.0.0.1. Render zet HOST zelf op 0.0.0.0 via render.yaml.
HOST=127.0.0.1
PORT=8000

# Browserlogin voor de hele app. Laat beide leeg om auth uit te zetten.
AUTH_USER=
AUTH_PASSWORD=

# Kling — optioneel. Zonder deze twee blijven de panelen getekende composities;
# de app werkt dan gewoon door. Aanmaken op klingai.com onder API/developer;
# de secret key krijg je maar één keer te zien.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Model en stijl overschrijven kan, maar de standaard is prima om te beginnen.
# KLING_MODEL=kling-v2
# KLING_STYLE=dreamlike illustration, flowing ink and watercolour, ...
