# Copy to .env and fill in. .env is git-ignored; this file is not, so never
# put a real secret here.

# Local port. Render injects PORT itself and overrides this.
PORT=8000
# 127.0.0.1 locally. Render routes to the container's external interface,
# so there it must be 0.0.0.0 — render.yaml sets that.
HOST=127.0.0.1

# Browser login for the whole app. Leave both blank to disable auth.
AUTH_USER=
AUTH_PASSWORD=
