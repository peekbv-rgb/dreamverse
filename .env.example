# Kopieer naar .env en vul in. .env staat in .gitignore; dit bestand niet,
# dus zet hier nooit een echte sleutel neer.

# Zonder sleutel draait de app in voorbeeldmodus: elke droom geeft dezelfde
# voorbeeldaflevering terug. Handig om te demonstreren, kost niets.
ANTHROPIC_API_KEY=

# Lokaal 127.0.0.1. Zet op 0.0.0.0 om de app vanaf je telefoon te kunnen
# openen op hetzelfde netwerk — zet dan ook AUTH_USER en AUTH_PASSWORD, anders
# kan iedereen op dat netwerk jouw Kling- en Runway-tegoed opmaken.
HOST=127.0.0.1
PORT=8000

# Browserlogin voor de hele app. Laat beide leeg om auth uit te zetten.
AUTH_USER=
AUTH_PASSWORD=

# Kling — optioneel. Zonder sleutel blijven de panelen getekende composities en
# werkt de app gewoon door. Sleutel aanmaken op kling.ai/dev/api-key.

# Het API Platform van Kling geeft één bearer-sleutel (begint met api-key-kling-).
# Dit is de gewone route:
KLING_API_KEY=

# Alleen als je nog een oud access/secret-paar hebt. Laat KLING_API_KEY dan leeg.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Standaard staan deze goed; alleen aanpassen als je iets anders wilt.
# KLING_BASE=https://api-singapore.klingai.com
# KLING_MODEL=kling-v2-1     # of kling-v3, nieuwer en duurder
# KLING_RESOLUTION=1k        # of 2k
# KLING_STYLE=dreamlike illustration, flowing ink and watercolour, ...
